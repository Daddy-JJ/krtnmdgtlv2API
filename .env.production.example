APP_NAME="Digital Identity Platform"
APP_ENV=production
APP_DEBUG=false
# Public frontend origin used for canonical card and user-facing links.
APP_URL=https://kartunamadigital.id
APP_TIMEZONE=Asia/Jakarta
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=digital_identity
DB_USERNAME=digital_identity_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Production uses a separate API subdomain, so credentialed CORS must list exact origins.
CORS_ALLOWED_ORIGINS=https://kartunamadigital.id,https://www.kartunamadigital.id

JWT_PRIVATE_KEY_PATH=storage/private/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/private/jwt-public.pem
JWT_ISSUER=kartunamadigital.id
JWT_AUDIENCE=kartunamadigital-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CSRF_HMAC_KEY=
OTP_HMAC_KEY=

COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=kartunamadigital.id

MIDTRANS_ENV=sandbox
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_NOTIFICATION_URL=https://api.kartunamadigital.id/api/v1/payments/midtrans/webhook
MIDTRANS_FINISH_URL=https://kartunamadigital.id/app/billing/result
MIDTRANS_UNFINISH_URL=https://kartunamadigital.id/app/billing/result
MIDTRANS_ERROR_URL=https://kartunamadigital.id/app/billing/result
MIDTRANS_HTTP_TIMEOUT_SECONDS=10

MAIL_HOST=mail.kartunamadigital.id
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@kartunamadigital.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@kartunamadigital.id
MAIL_FROM_NAME="Kartunama Digital"
MAIL_REPLY_TO_ADDRESS=support@kartunamadigital.id
MAIL_TIMEOUT_SECONDS=15
MAIL_VERIFY_PEER=true
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SEND_LIMIT_PER_HOUR=5
