{
  "name": "@kartunamadigital/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SOT-driven Node.js and Express modular monolith for KartuNamaDigital.id",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "test:db": "RUN_DB_TESTS=true node --test tests/Integration/database.test.ts",
    "migrate": "node scripts/migrate.ts up",
    "migrate:status": "node scripts/migrate.ts status",
    "migrate:rollback": "node scripts/migrate.ts down",
    "seed": "node scripts/seed.ts",
    "seed:local-qa": "node scripts/seed-local-qa-users.ts",
    "keys:generate": "node scripts/generate-jwt-keys.ts",
    "hosting:preflight": "node scripts/hosting-preflight.ts",
    "mail:work": "node scripts/mail-worker.ts",
    "resume:work": "node scripts/resume-worker.ts",
    "mail:verify": "node scripts/smtp-verify.ts",
    "qa": "npm run typecheck && npm test && npm audit --audit-level=high"
  },
  "dependencies": {
    "@types/nodemailer": "8.0.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "midtrans-client": "1.4.3",
    "multer": "2.2.0",
    "mysql2": "3.23.0",
    "nodemailer": "9.0.3",
    "qrcode": "1.5.4",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.18.0",
    "@types/pngjs": "6.0.5",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
