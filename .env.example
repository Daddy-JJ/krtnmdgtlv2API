APP_NAME="Digital Identity Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=krtnmdgtlv2
DB_USERNAME=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Leave empty for same-origin local development. Never use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

JWT_PRIVATE_KEY_PATH=storage/private/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/private/jwt-public.pem
JWT_ISSUER=kartunamadigital.id
JWT_AUDIENCE=kartunamadigital-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Generate unique values of at least 32 characters; do not commit real values.
CSRF_HMAC_KEY=
OTP_HMAC_KEY=

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

MIDTRANS_ENV=sandbox
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_NOTIFICATION_URL=
MIDTRANS_FINISH_URL=
MIDTRANS_UNFINISH_URL=
MIDTRANS_ERROR_URL=
MIDTRANS_HTTP_TIMEOUT_SECONDS=10

MAIL_HOST=mail.kartunamadigital.id
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@kartunamadigital.id
MAIL_FROM_NAME="Kartunama Digital"
MAIL_REPLY_TO_ADDRESS=support@kartunamadigital.id
MAIL_TIMEOUT_SECONDS=15
MAIL_VERIFY_PEER=true
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SEND_LIMIT_PER_HOUR=5
